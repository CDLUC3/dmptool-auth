{
  "name": "@dmptool/auth-service",
  "version": "0.1.0",
  "private": true,
  "description": "DMP Tool authentication and OpenID Connect authorization service",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "rm -rf ./dist && npm run compile",
    "compile": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "npx eslint . --ignore-pattern dist/",
    "prepare": "is-ci || npx husky install",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "trivy-high": "sh ./src/scripts/trivy-high.sh",
    "trivy-med": "sh ./src/scripts/trivy-med.sh",
    "trivy-all": "npm run trivy-high && npm run trivy-med"
  },
  "dependencies": {
    "@dmptool/utils": "^2.1.9",
    "@keyv/valkey": "^1.0.11",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jose": "^6.1.3",
    "keyv": "^5.6.0",
    "mysql2": "^3.14.4",
    "nodemailer": "^10.0.10",
    "oidc-provider": "^9.11.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/oidc-provider": "^9.11.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.0.1",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.5",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
