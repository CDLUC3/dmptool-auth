# Settings for the Auth service
NODE_ENV=development
PORT=4080
DEPLOYMENT_ENV=dev
LOG_LEVEL=debug

APPLICATION_NAME=my-app
DOMAIN=http://localhost:3000
HELP_DESK_ADDRESS=help@example.com
HELP_PAGE_URL=http://localhost:3000/help
DO_NOT_REPLY_ADDRESS=no-reply@example.com

# The URL of the OIDC issuer
ISSUER=http://localhost:4080
# The browser access-token audience followed by any additional valid audiences (semicolon separated)
TOKEN_AUDIENCE=http://localhost:3000;http://localhost:4646

# Token names
ACCESS_TOKEN_NAME=access_token
REFRESH_TOKEN_NAME=refresh_token
SSO_PENDING_TOKEN_NAME=sso_pending_token

# The URL to redirect users to for signing in via OAuth2.
OAUTH2_SIGN_IN_URL=http://localhost:3000/auth-signin

# Development/bootstrap fallback used only while oauth_clients has no active records. Example:
# OIDC_CLIENTS_JSON=[{"client_id":"dmp-ui","client_secret":"change-me","redirect_uris":["http://localhost:3001/callback"],"grant_types":["authorization_code","refresh_token"],"response_types":["code"],"token_endpoint_auth_method":"client_secret_basic"}]
OIDC_CLIENTS_JSON=[]

# COOKIE, TOKEN and BCRYPT settings
COOKIE_SECURE=false
PEPPER_SECRET=change-me
BCRYPT_SALT_ROUNDS=10

# SES Email settings
SES_ENDPOINT=email-smtp.us-west-2.amazonaws.com
SES_PORT=587

# UI TTLs
CSRF_TTL=3600 # 1 hour (more than enough time for a user to complete a task)
UI_ACCESS_TOKEN_TTL=900 # 15 minutes (short lived for the current activity)
UI_REFRESH_TOKEN_TTL=604800 # 7 days
PASSWORD_RESET_TOKEN_TTL=7200 # 2 hours

# OIDC TTLs
OIDC_CODE_TTL=120 # 2 minutes (more than enough time for the external system to fetch a token)
OIDC_ACCESS_TOKEN_TTL=900 # 15 minutes (short lived for the current activity)
OIDC_REFRESH_TOKEN_TTL=3.154e+7 # 365 days (external system can store locally and refresh as needed)
OIDC_GRANT_TTL=120 # 2 minutes (more than enough time for the external system to fetch a token)
OIDC_ID_TOKEN_TTL=600  # 10 minutes
OIDC_INTERACTION_TTL=600  # 10 minutes (more than enough time for the user to complete the login process)

# A secret that can be used to sign and verify Shibboleth proxy requests. This is optional, but recommended if you
# are using Shibboleth. It prevents malicious users from forging requests to the Shibboleth proxy endpoint. If you
# do not set this, the Shibboleth proxy endpoint will be disabled.
SHIBBOLETH_PROXY_SECRET=change-me

# Database Config
DB_USERS_TABLE=users
DB_USER_EMAILS_TABLE=user_emails
DB_TEMPLATE_COLLABORATORS_TABLE=template_collaborators
DB_PROJECT_COLLABORATORS_TABLE=project_collaborators
DB_AUTH_KEYS_TABLE=auth_keys
DB_OAUTH_CLIENTS_TABLE=oauth_clients
DB_OAUTH_CLIENT_REDIRECT_URIS_TABLE=oauth_client_redirect_uris
DB_OIDC_RECORDS_TABLE=oidc_records

# ValKey Cache Config
CACHE_CONNECT_TIMEOUT=30000 # 30 seconds
CACHE_DISCONNECT_TIMEOUT=30000 # 30 seconds
CACHE_KEEP_ALIVE=60000 # 1 minute

# NOTE that some variables are defined in the docker-compose.yml file, and will be set automatically when running in a
# Docker container. When setting up your environment in a non-Docker environment, you will need to set these variables
# manually. See the docker-compose.yml file for details.